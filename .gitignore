# Runtime state is private by default. Only the frozen, small development
# evidence needed to inspect the current Jensen/prospective claims is tracked.
state/*
!state/jensen-policy-curve-protocol-v3.json
!state/jensen-policy-curve-evaluation-v3.json
!state/jensen-reliability-window-exposure-audit-v1.json
!state/jensen-reliability-stress-protocol-v1.json
!state/jensen-reliability-stress-evaluation-v1.json
!state/prospective-v2-design-handoff-v1.json
!state/prospective-v2-design-handoff-verification-v1.json

